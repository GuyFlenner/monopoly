{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],

    /* Strictness. The engine is mypy-strict; the UI holds the same bar. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  // `e2e` and the Playwright config are included so `tsc --noEmit` and the type-aware ESLint
  // preset cover them like everything else. Left out, they were checked by nothing: the specs
  // typechecked only as a side effect of Playwright running them, which is the wrong end of the
  // loop for a strict-mode repository.
  "include": ["src", "vite.config.ts", "e2e", "playwright.config.ts"]
}
